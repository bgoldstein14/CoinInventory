{
  // Build-only config for "npm run build". tsconfig.json includes specs so
  // `tsc --noEmit` type-checks them; they must not be emitted into dist/, where
  // Vitest would find and fail to run the compiled copies.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "test-support"
  ]
}
