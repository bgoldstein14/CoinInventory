{
  "name": "coin-inventory-server",
  "version": "1.0.0",
  "description": "SQLite-backed Express API for the Coin Inventory Angular app",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch server.ts",
    "test": "vitest run",
    "migrate:from-sqlserver": "tsx migrate-sqlserver/cli.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "msnodesqlv8": "^5.3.0",
    "mssql": "^11.0.1"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@0.28.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
